# configs
COMPOSE_PROFILES=

# ======================
#       Bisno
# ======================
BISNO_SERVER_PORT=3333

# ======================
#       Database
# ======================
DB_NAME=bisno
DB_DIALECT=postgres
DB_PORT=5432
DB_HOST=localhost
DB_USER=bisno
DB_PASSWORD=

# ======================
#       RabbitMQ
# ======================
RABBITMQ_URI=amqp://username:password@hostname:port
RABBIT_USER=bisno
RABBIT_HOST=localhost
RABBIT_PASSWORD=
RABBIT_PORT=5672

# ======================
#       Redis
# ======================
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_URI=redis://:password@host:port/6

# ======================
#    Evolution API
# ======================

EVOLUTION_DATABASE_SCHEMA=bisno_evolution_exchange
EVOLUTION_DATABASE_PROVIDER=postgresql
EVOLUTION_POSTGRES_DATABASE=bisno_evolution_db
EVOLUTION_DATABASE_CONNECTION_CLIENT_NAME=bisno
EVOLUTION_SERVER_URL=http://evolution-api:8080
EVOLUTION_SERVER_HOST=evolution-api

EVOLUTION_AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
EVOLUTION_EVOLUTION_OPERATOR_EMAIL=mail@domain.com
EVOLUTION_AUTHENTICATION_API_KEY=

EVOLUTION_CACHE_REDIS_URI=redis://:password@host:6379/6
EVOLUTION_CACHE_REDIS_PREFIX_KEY=bisno_evolution
EVOLUTION_RABBITMQ_EXCHANGE_NAME='evolution.bisno.exchange'